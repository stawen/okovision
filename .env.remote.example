ORIGIN=http://localhost:3000
APP_PORT=3000
# Langue des messages backend : FR ou EN.
APP_LANG=FR

# Adresse DNS ou IP, avec port facultatif (3306 par défaut).
DB_ADRESSE=db.example.com:3306
DB_NAME=okovision
DB_USER=okovision_readonly
DB_PASSWORD=replace-me
# TLS vérifié par défaut ; utiliser disabled uniquement si nécessaire.
DB_TLS_MODE=verify
# DB_TLS_CA_FILE=/path/to/ca.pem
