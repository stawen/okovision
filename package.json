{
	"name": "okovision",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.10.0 <27"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev",
		"predev:local": "npm run db:up",
		"dev:local": "node --env-file=.env.dev ./node_modules/vite/bin/vite.js dev",
		"preappsetup": "docker compose --env-file .env.appsetup -f compose.dev.yaml --profile setup up -d --wait db-setup && node --env-file=.env.appsetup scripts/check-db.ts",
		"appsetup": "node --env-file=.env.appsetup ./node_modules/vite/bin/vite.js dev",
		"appsetup:down": "docker compose --env-file .env.appsetup -f compose.dev.yaml --profile setup stop db-setup",
		"build": "vite build",
		"start": "node --env-file-if-exists=.env build",
		"db:check": "node --env-file-if-exists=.env scripts/check-db.ts",
		"db:check:local": "node --env-file=.env.dev scripts/check-db.ts",
		"db:migrate": "node --env-file-if-exists=.env ./node_modules/knex/bin/cli.js --knexfile knexfile.js",
		"db:migrate:local": "node --env-file=.env.dev ./node_modules/knex/bin/cli.js --knexfile knexfile.js",
		"db:migrate:setup": "node --env-file=.env.appsetup ./node_modules/knex/bin/cli.js --knexfile knexfile.js",
		"db:up": "docker compose --env-file .env.dev -f compose.dev.yaml up -d --wait db",
		"db:down": "docker compose --env-file .env.dev -f compose.dev.yaml --profile test down",
		"db:test:up": "docker compose --env-file .env.dev -f compose.dev.yaml --profile test up -d --wait --force-recreate db-test db-setup-test",
		"test:db": "npm run db:test:up && node --env-file=.env.dev --test tests/integration/local-db.test.ts tests/integration/migrations.test.ts tests/integration/setup.test.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"dependencies": {
		"highcharts": "13.1.1",
		"knex": "3.3.0",
		"mysql2": "3.24.6",
		"node-cron": "4.6.0",
		"svelte-sonner": "1.2.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@sveltejs/adapter-node": "6.0.2",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "26.6.6",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
